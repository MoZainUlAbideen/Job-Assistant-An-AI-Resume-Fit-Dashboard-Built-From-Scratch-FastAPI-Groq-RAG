# Copy to .env (never commit .env). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Groq retired llama-3.3-70b-versatile on 2026-08-16; this is their recommended replacement
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated frontend origins allowed to call the API (your Vercel URL). "*" = anyone.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
