{
  "manifest_version": 3,
  "name": "Job Control Capture",
  "version": "1.0.0",
  "description": "Bulk-captures job listings from a LinkedIn or Indeed search results page you're already viewing, and scores them against your resume in Job Control.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
